{
  "description": "Tool with a marketing page and a members' app, run with the three design skills installed — each surface gets its lead, and the generated tests actually run",
  "phases": ["scope", "architect", "design", "build"],
  "harness": {
    "plugins": [
      { "name": "ui-ux-pro-max", "repo": "nextlevelbuilder/ui-ux-pro-max-skill", "ref": "a38d04c3d5c298c851dbe5e6ee1965ee3de42cb5", "track": "tags" },
      { "name": "taste-skill", "repo": "leonxlnx/taste-skill", "ref": "f6b76575f949707b4e3c37cd86cb44b0b98643e8", "track": "tags" },
      { "name": "design-motion-principles", "repo": "kylezantos/design-motion-principles", "ref": "57e6fe2416d5f417ab731d247b6ab606eb408c9a", "track": "tags" }
    ],
    "e2e": true
  },
  "expect": {
    "sizeClass": "tool",
    "hasUI": true,
    "approvals": ["scope", "architecture", "design"],
    "escalation": null,
    "skills": { "present": ["frontend", "qa", "gitflow", "context-memory"] },
    "files": { "present": ["DESIGN.md", "e2e"] },
    "contains": [
      { "file": "DESIGN.md", "pattern": "ui-ux-pro-max", "why": "with it installed, ui-ux-pro-max leads the members' app and owns the tokens" },
      { "file": "DESIGN.md", "pattern": "taste", "why": "with it installed, taste-skill leads the public page" },
      { "file": "DESIGN.md", "pattern": "design-motion-principles", "why": "with it installed, design-motion-principles owns motion" },
      { "file": "CLAUDE.md", "pattern": "DESIGN\\.md", "why": "CLAUDE.md links the binding design decision" }
    ],
    "notContains": [
      { "file": "DESIGN.md", "pattern": "Lead skills:\\*{0,2}\\s*built-in", "why": "the built-in fallback must not lead when the design skills are installed" }
    ]
  }
}
